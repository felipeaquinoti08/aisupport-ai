# =====================================================================
# Agente de Suporte N1 - configuração da pilha de IA
# Copie para .env (cp .env.example .env) e preencha. Permissão: chmod 600 .env
# A aba "Servidor de IA: instalação" do plugin gera este arquivo pré-preenchido.
# =====================================================================

COMPOSE_PROJECT_NAME=glpi-ai

# Baixa os modelos automaticamente a cada "docker compose up" (serviço
# model-puller; pula os que já existem). Útil no Komodo/Portainer. Deixe
# vazio para baixar só manualmente: docker compose --profile setup run --rm model-puller
COMPOSE_PROFILES=

# --- Imagens (fixe versões testadas; atualize conscientemente) -------
OLLAMA_IMAGE=ollama/ollama:0.35.1
QDRANT_IMAGE=qdrant/qdrant:v1.19.1-unprivileged

# --- Exposição da ai-api ----------------------------------------------
# IP do host onde a porta será publicada. Use o IP da VPN/rede privada
# alcançável pelo servidor do GLPI. 127.0.0.1 = apenas local.
AI_API_BIND=127.0.0.1
AI_API_PORT=8080

# Chave compartilhada entre o plugin e a ai-api (mín. 32 caracteres).
# Gere com: openssl rand -hex 32  (ou copie da aba de instalação do plugin)
AI_API_KEY=

# IPs/redes (CIDR, separados por vírgula) autorizados a chamar a ai-api.
# Vazio = qualquer origem que tenha a chave. Ex.: 10.0.0.5/32
AI_API_ALLOWED_IPS=

# TLS opcional direto na ai-api. Coloque os arquivos em ./certs/
# AI_API_TLS_CERT=/certs/server.crt
# AI_API_TLS_KEY=/certs/server.key
AI_API_TLS_CERT=
AI_API_TLS_KEY=

# --- GLPI (API REST v2) - usado SOMENTE para LER a Base de Conhecimento
GLPI_URL=https://glpi.example.com
# Cliente OAuth criado em Configurar > OAuth clients (grant "password", escopo "api")
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
# Conta de serviço com perfil somente-leitura da Base de Conhecimento
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_VERIFY_SSL=true
# Caminho de um CA próprio dentro do container (ex.: /certs/ca.pem), opcional
GLPI_CA_BUNDLE=
GLPI_TIMEOUT=20
# Fuso horário das datas do GLPI (validade dos artigos)
GLPI_TIMEZONE=America/Sao_Paulo

# --- Qdrant -------------------------------------------------------------
# Gere com: openssl rand -hex 32
QDRANT_API_KEY=
QDRANT_COLLECTION=glpi_kb

# --- Modelos --------------------------------------------------------------
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=qwen3-embedding:0.6b
# Modelos adicionais para benchmark (separados por espaço), opcional
EXTRA_MODELS=

LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=180
# Contexto do modelo de embeddings (trechos têm ~350 tokens; 512 economiza ~1 GB de RAM)
EMBED_NUM_CTX=512
OLLAMA_KEEP_ALIVE=-1
# Threads de CPU do modelo (0 = automático = núcleos físicos). Com
# hyper-threading, use o total de vCPUs (ex.: 4) para ~15% mais velocidade.
LLM_NUM_THREAD=0

# --- RAG --------------------------------------------------------------------
# Score mínimo (similaridade de cosseno) do melhor trecho para aceitar uma
# resposta. NÃO é um valor universal: calibre com
#   docker compose exec ai-api python -m app.calibrate
RAG_MIN_SCORE=0.55
# Fração mínima dos termos da pergunta presentes nos trechos escolhidos
RAG_MIN_TERM_COVERAGE=0.25
# Fração mínima dos termos da resposta do LLM presentes nos documentos
RAG_MIN_ANSWER_OVERLAP=0.45
# Trechos enviados ao LLM / candidatos devolvidos para checagem de permissão
RAG_TOP_K=3
RAG_CANDIDATES=20
# Limite de caracteres de contexto enviado ao LLM (impacta o tempo de resposta)
RAG_MAX_CONTEXT_CHARS=4500
# Excluir do contexto artigos marcados como suspeitos de prompt injection
RAG_EXCLUDE_SUSPICIOUS=true
# Tamanho dos trechos (caracteres) e sobreposição
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# --- Sincronização da Base de Conhecimento ----------------------------------
# Intervalo da sincronização incremental automática (0 = desativada)
SYNC_INTERVAL_MINUTES=15

# --- Limites de memória/CPU (soma das memórias = 4 GB) -----------------------
OLLAMA_MEM_LIMIT=3456m
QDRANT_MEM_LIMIT=320m
AI_API_MEM_LIMIT=320m
OLLAMA_CPUS=4
QDRANT_CPUS=1
AI_API_CPUS=1
OLLAMA_MAX_QUEUE=16

# --- Logs -----------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
